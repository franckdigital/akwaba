# ===================== Akwaba Auto-École : backend/.env (PRODUCTION) =====================
# Sur le serveur : copier ce fichier vers /var/www/akwaba/backend/.env  puis  chmod 600 (propriétaire : akwaba). NE JAMAIS le committer.

DEBUG=0
SECRET_KEY=2aoG2jLGS6ZhMpRO7TPL1CfDxmA_PXFq9kSBlhCf9dNJEGQs_oa6gJVkUsWgRVVUh24K7GDYowSJoT52ru_pMQ
ALLOWED_HOSTS=api.ae-akwabatreich.com,ae-akwabatreich.com,www.ae-akwabatreich.com,127.0.0.1,localhost

# --- Base de données MySQL ---
DB_NAME=akwaba
DB_USER=root
DB_PASSWORD=Numerix@2026
DB_HOST=127.0.0.1
DB_PORT=3306

# --- URLs publiques ---
PUBLIC_WEB_URL=https://ae-akwabatreich.com
BACKEND_BASE_URL=https://api.ae-akwabatreich.com
CORS_ORIGINS=https://ae-akwabatreich.com,https://www.ae-akwabatreich.com
CSRF_TRUSTED_ORIGINS=https://ae-akwabatreich.com,https://www.ae-akwabatreich.com,https://api.ae-akwabatreich.com

# --- Sécurité HTTPS (nginx fait déjà la redirection HTTP -> HTTPS) ---
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

# --- Paiements CinetPay : SANDBOX (clés sk_test_...). La clé live est refusée tant que CINETPAY_ALLOW_LIVE=0 ---
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_ALLOW_LIVE=0
PAYMENT_WEBHOOK_SECRET=_P-tkjDxTjdCQua1AZhYEUED-pSSijibz26drBB04njc3miSJoO-EQ

# --- E-mail Gmail (SMTP) : mot de passe d'application Google (Compte Google > Sécurité > Validation en 2 étapes > Mots de passe d'application) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=numerix.digital@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Akwaba Auto-École <numerix.digital@gmail.com>

# --- WhatsApp Business (Cloud API Meta) : WHATSAPP_PROVIDER=meta ; ou Twilio : WHATSAPP_PROVIDER=twilio ; log = simple journal ---
WHATSAPP_PROVIDER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Twilio (SMS et/ou WhatsApp) : SMS_PROVIDER=twilio pour activer les SMS ---
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Connexion vocale côté serveur (facultatif) : API compatible OpenAI /v1/audio/transcriptions ---
VOICE_STT_URL=
VOICE_STT_KEY=
VOICE_STT_MODEL=whisper-1
