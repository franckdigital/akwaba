# Copier ce fichier en backend/.env (jamais versionné) puis renseigner les identifiants SANDBOX CinetPay.
# Sans identifiants, le paiement est SIMULÉ localement (mode démonstration, DEBUG uniquement).
#CINETPAY_API_KEY=sk_test_xxxxxxxxxxxxxxxx
#CINETPAY_API_PASSWORD=xxxxxxxx
# URL publique de l'API (notify_url CinetPay) : en local, exposer le port 8010 avec un tunnel (ngrok...) pour recevoir le webhook.
# Sans webhook, le retour navigateur (/checkout/return) re-vérifie le paiement auprès de CinetPay.
BACKEND_BASE_URL=http://127.0.0.1:8010
PUBLIC_WEB_URL=http://localhost:5180
# Les clés sk_live_ sont REFUSÉES tant que CINETPAY_ALLOW_LIVE=1 n'est pas défini (ne le faites pas en développement).

CINETPAY_API_KEY=146568214666e323728ed8f0.52747552
CINETPAY_API_PASSWORD=
CINETPAY_SITE_ID=105893574
CINETPAY_MOCK=True



# --- E-mail Gmail (SMTP) : mot de passe d'application Google (Compte Google > Sécurité > Validation en 2 étapes > Mots de passe d'application) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=numerix.digital@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Akwaba Auto-École <numerix.digital@gmail.com>

# --- WhatsApp Business (Cloud API Meta) : WHATSAPP_PROVIDER=meta ; ou Twilio : WHATSAPP_PROVIDER=twilio ; log = simple journal ---
WHATSAPP_PROVIDER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- Twilio (SMS et/ou WhatsApp) : SMS_PROVIDER=twilio pour activer les SMS ---
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
